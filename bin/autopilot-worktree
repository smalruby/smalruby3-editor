#!/usr/bin/env bash
# bin/autopilot-worktree — しゅっと作れる軽量 worktree（autopilot 用）。
#
# autopilot は Issue ごとに git worktree を切って隔離作業する。毎回
# `npm install` / `build:dev` していたら遅いので、**ビルド成果物は共有**し、
# **状態 (.env) はコピー**して、最小の手順で即作業可能にする。
#
# 仕組み（なぜ install/build が要らないか）:
#   - root `node_modules` を main checkout のものへ symlink（devpod の named
#     volume 実体を共有）。npm workspaces のリンク `node_modules/@smalruby/<pkg>`
#     は相対 symlink なので、main checkout の `packages/<pkg>`（dist ビルド済み）
#     に解決される。→ worktree 側で build:dev 不要。
#   - 各 `packages/<pkg>/node_modules` も main へ symlink（scratch-gui の
#     scratch-blocks 等 local 依存の解決用）。
#   - `.env.*` は `bin/sync-worktree-env` で**コピー**（symlink にしない:
#     誤書き込みで main の秘密を壊さないため。`.claude/rules/env-file.md`）。
#   - `.husky/_` も main へ symlink。commit-msg フック（共有 `core.hooksPath`）が
#     source する husky.sh は npm install の生成物なので、無いと commit / merge が
#     まるごと失敗する（Issue #1137）。
#   - `infra/<project>/node_modules` は、main の入っている版が worktree の lock と
#     同じときだけ main へ symlink し、違えば lock でキーにした共有の置き場
#     （`<WT_ROOT>/.infra-node-modules/`）で 1 回だけ `npm ci` してそこへ symlink する
#     （Issue #1454 / #1456）。
#
# 制約（lightweight モードの前提）:
#   - **単一パッケージのソース編集**を想定。`@smalruby/<pkg>` は main checkout に
#     解決されるため、worktree で scratch-vm のソースを編集しても scratch-gui の
#     テストはそれを見ない（main の dist を見る）。
#   - **クロスパッケージのソース編集**（編集した sibling を再ビルドして参照させたい）
#     場合は `--full` を使う（worktree 内で実 npm install + build:dev、symlink 無し）。
#
# Usage:
#   bin/autopilot-worktree create <issue> [base-ref]   # 既定 base: origin/develop（新ブランチ）
#   bin/autopilot-worktree create <issue> --full        # 重い完全セットアップ
#   bin/autopilot-worktree create <issue> --branch <name>  # 既存ブランチを checkout
#   bin/autopilot-worktree create <issue> --pr <number>    # PR のヘッドブランチを checkout（address-review 用）
#   bin/autopilot-worktree path <issue>                 # worktree パスを表示
#   bin/autopilot-worktree remove <issue> [--delete-branch]
#   bin/autopilot-worktree list
#   bin/autopilot-worktree prune-infra-store            # 使われていない infra の共有置き場を消す
#
# 環境変数:
#   AUTOPILOT_WORKTREE_ROOT  worktree を作る親dir
#                            （既定: <main checkout>/.autopilot-worktrees）
#                            既定はリポジトリ直下（gitignore 済み）。devpod では /app が
#                            bind mount で永続するため、rebuild しても worktree の実体と
#                            .git/worktrees メタデータが同じ mount 上で同期し続ける。
#                            （旧既定 $HOME/autopilot-worktrees は /root 配下 = ephemeral で
#                             rebuild ごとに消え、stale 登録が残って dispatch が壊れていた）
#   AUTOPILOT_BRANCH_PREFIX  ブランチ接頭辞（既定: topic/autopilot-）
set -euo pipefail

MAIN_CHECKOUT=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [[ -z "${MAIN_CHECKOUT}" ]]; then
    echo "error: not inside a git repository" >&2
    exit 1
fi
# worktree の中で実行された場合も main checkout を基準にする
GIT_COMMON_DIR=$(git rev-parse --git-common-dir)
GIT_COMMON_ABS=$(cd "${GIT_COMMON_DIR}" && pwd)
MAIN_CHECKOUT=$(dirname "${GIT_COMMON_ABS}")

WT_ROOT="${AUTOPILOT_WORKTREE_ROOT:-${MAIN_CHECKOUT}/.autopilot-worktrees}"
BRANCH_PREFIX="${AUTOPILOT_BRANCH_PREFIX:-topic/autopilot-}"

wt_path() { echo "${WT_ROOT}/issue-$1"; }
wt_branch() { echo "${BRANCH_PREFIX}$1"; }

# 登録済みの worktree か。一覧を変数に受けてから照合する。
# `git worktree list --porcelain | grep -q` は pipefail 下で一致しても失敗しうる
# （grep が先に終わり、まだ書いている git が SIGPIPE で落ちてパイプ全体が 141 になる）。
# worktree が増えて一覧が長いと毎回起き、登録済みを未登録と誤判定して
# `fatal: '<wt>' already exists` で create が失敗していた（#1202 が Blocked になった原因）。
is_registered_worktree() {
    local list
    list=$(git -C "${MAIN_CHECKOUT}" worktree list --porcelain)
    grep -qxF "worktree $1" <<<"${list}"
}

# `git worktree add -b` は新ブランチの upstream 設定で共有 .git/config をロックする。
# daemon が複数 Issue を同時ディスパッチすると複数の `autopilot-worktree create` が並行し、
# `could not lock config file .git/config: File exists` で worktree 作成が失敗する（#681/#958）。
# ロック競合はジッタ付きで数回リトライして吸収する（それ以外のエラーはそのまま返す）。
#
# 注意（#1226）: `-b` 付きの add は **ブランチの ref を作ってから** config をロックするため、
# ロック失敗後もブランチだけが残る。同じ `-b` 引数で再実行すると
# `a branch named ... already exists`（ロック以外のエラー）で失敗し Blocked になっていた。
# そこでリトライ時に残ったブランチが「今回の失敗で作られたもの（起点と同じコミット）」
# なら `-b` を外して `worktree add <wt> <branch>` で作り直し、書けなかった upstream を
# 後から設定する。起点と違うコミットのブランチは無関係とみなし、使わずに失敗を返す。
git_wt_add_retry() {
    local attempt out rc
    local new_branch="" wt="" start="" adopted=false
    local -a args=("$@")
    if [[ "${1:-}" == "-b" ]]; then
        new_branch="$2"; wt="$3"; start="$4"
    fi
    for attempt in 1 2 3 4 5 6; do
        if [[ -n "${new_branch}" && "${adopted}" == "false" && "${attempt}" -gt 1 ]] \
            && git -C "${MAIN_CHECKOUT}" show-ref --verify --quiet "refs/heads/${new_branch}"; then
            adopt_leftover_branch "${new_branch}" "${wt}" "${start}" || return 1
            adopted=true
            args=("${wt}" "${new_branch}")
        fi
        # `if out=$(...); then ... fi` の後の `$?` は 0 になるので、終了コードはここで取る
        out=$(git -C "${MAIN_CHECKOUT}" worktree add "${args[@]}" 2>&1) && rc=0 || rc=$?
        if [[ "${rc}" -eq 0 ]]; then
            [[ -n "${out}" ]] && printf '%s\n' "${out}"
            if [[ "${adopted}" == "true" ]]; then
                set_upstream_retry "${new_branch}" "${start}"
            fi
            return 0
        fi
        if grep -q "could not lock config file" <<<"${out}"; then
            echo "info: .git/config ロック競合で worktree add 失敗、リトライ ${attempt}/6" >&2
            sleep "0.$((RANDOM % 7 + 3))"   # 0.3〜0.9s のジッタで再衝突を避ける
            continue
        fi
        printf '%s\n' "${out}" >&2
        return "${rc}"
    done
    echo "error: worktree add が .git/config ロック競合で 6 回失敗しました（並行作成の輻輳）" >&2
    printf '%s\n' "${out}" >&2
    return 1
}

# ロック失敗で残ったブランチを引き取る前の確認と片付け（#1226）。
# - ブランチが起点と同じコミットでなければ、今回の失敗で作られたものではない
#   （無関係な既存ブランチ）ので使わない。人間が確認できるようブランチには触らない。
# - 実体の無い worktree 登録は prune で片付ける。`-b` の add はブランチ作成（ロック失敗点）を
#   作業場所の作成より先に行い、失敗した add の残骸は git 自身が消すため、ここで登録や
#   中身のあるディレクトリが見つかるのは別プロセス由来。未コミットの作業を消さないよう、
#   空ディレクトリ以外は削除せずに失敗を返す。
adopt_leftover_branch() {
    local branch="$1" wt="$2" start="$3"
    local branch_sha start_sha
    branch_sha=$(git -C "${MAIN_CHECKOUT}" rev-parse --verify --quiet "refs/heads/${branch}^{commit}") || branch_sha=""
    start_sha=$(git -C "${MAIN_CHECKOUT}" rev-parse --verify --quiet "${start}^{commit}") || start_sha=""
    if [[ -z "${branch_sha}" || -z "${start_sha}" || "${branch_sha}" != "${start_sha}" ]]; then
        echo "error: branch ${branch} exists but was not created from ${start} (${branch_sha:-?} != ${start_sha:-?}); refusing to reuse it" >&2
        return 1
    fi
    echo "info: ロック競合で残ったブランチ ${branch} を引き取って worktree を作り直します" >&2
    git -C "${MAIN_CHECKOUT}" worktree prune >/dev/null 2>&1 || true
    if is_registered_worktree "${wt}"; then
        echo "error: ${wt} is already registered as a worktree; refusing to replace it" >&2
        return 1
    fi
    if [[ -d "${wt}" ]]; then
        if [[ -z "$(ls -A "${wt}" 2>/dev/null)" ]]; then
            rmdir "${wt}"
        else
            echo "error: ${wt} exists and is not empty; refusing to overwrite it" >&2
            return 1
        fi
    fi
}

# `-b` が書けなかった upstream を設定する（これも .git/config をロックするのでリトライ）。
# 失敗しても worktree は使えるので warn に留める（push は明示 remote/branch で行う）。
set_upstream_retry() {
    local branch="$1" start="$2" attempt
    # 起点がリモート追跡ブランチのときだけ（`-b` の既定動作 autoSetupMerge と同じ）
    git -C "${MAIN_CHECKOUT}" show-ref --verify --quiet "refs/remotes/${start}" || return 0
    for attempt in 1 2 3 4 5 6; do
        if git -C "${MAIN_CHECKOUT}" branch --set-upstream-to="${start}" "${branch}" >/dev/null 2>&1; then
            return 0
        fi
        sleep "0.$((RANDOM % 7 + 3))"
    done
    echo "warn: ${branch} の upstream (${start}) を設定できませんでした（worktree は作成済み）" >&2
}

# worktree の git exclude に node_modules を追記（冪等・コミット不要）。
# 理由: node_modules を main へ symlink して共有するが、古い base ブランチの
# `.gitignore` は `node_modules/`（末尾スラッシュ=ディレクトリのみ）で symlink を
# 無視できず、`git add -A` で誤ってステージされる（Issue #801 / PR #800）。
# `.gitignore` 側も symlink を無視するよう修正済みだが、修正前の base から切った
# worktree でも確実に無視されるよう保険として exclude にも入れる。
# info/exclude は共有 (git-common-dir) なので 1 度書けば全 worktree に効く。
exclude_node_modules() {
    local wt="$1"
    local exclude
    exclude=$(cd "${wt}" && git rev-parse --git-path info/exclude 2>/dev/null) || return 0
    [[ -n "${exclude}" ]] || return 0
    mkdir -p "$(dirname "${exclude}")"
    touch "${exclude}"

    local marker="# autopilot: ignore shared node_modules symlinks (Issue #801)"
    if ! grep -qxF "${marker}" "${exclude}" 2>/dev/null; then
        {
            echo "${marker}"
            echo "node_modules"
            echo "packages/*/node_modules"
        } >> "${exclude}"
        echo "excluded: node_modules symlinks via ${exclude}"
    fi

    # scratch-gui の prepare 生成物 symlink も同様に保険で無視する（Issue #1001）。
    # これらは packages/scratch-gui/.gitignore が末尾スラッシュ（`src/generated/` 等）で
    # 無視するが、末尾スラッシュはディレクトリのみに一致し symlink には効かない（#801 と同型）。
    # 末尾スラッシュ無し・root 相対のパターンで symlink も確実に無視させる。
    local prep_marker="# autopilot: ignore shared scratch-gui prepare artifact symlinks (Issue #1001)"
    if ! grep -qxF "${prep_marker}" "${exclude}" 2>/dev/null; then
        {
            echo "${prep_marker}"
            echo "packages/scratch-gui/src/generated"
            echo "packages/scratch-gui/static/microbit"
            echo "packages/scratch-gui/static/microbitMore"
        } >> "${exclude}"
        echo "excluded: scratch-gui prepare artifact symlinks via ${exclude}"
    fi

    # husky の生成物 symlink も同様（Issue #1137）。husky は `.husky/_/.gitignore`（中身は `*`）
    # で自分自身を無視するが、git は **symlink を辿ってその .gitignore を読まない**ため、
    # `.husky/_` symlink は未追跡として現れてしまう（#801 / #1001 と同型の抜け）。
    local husky_marker="# autopilot: ignore shared husky helper symlink (Issue #1137)"
    if ! grep -qxF "${husky_marker}" "${exclude}" 2>/dev/null; then
        {
            echo "${husky_marker}"
            echo ".husky/_"
        } >> "${exclude}"
        echo "excluded: husky helper symlink via ${exclude}"
    fi

    # infra/<project>/node_modules の symlink も同様（Issue #1454）。infra 各プロジェクトの
    # .gitignore は `node_modules/`（末尾スラッシュ）で、symlink には効かない（#801 と同型）。
    local infra_marker="# autopilot: ignore shared infra node_modules symlinks (Issue #1454)"
    if ! grep -qxF "${infra_marker}" "${exclude}" 2>/dev/null; then
        {
            echo "${infra_marker}"
            echo "infra/*/node_modules"
        } >> "${exclude}"
        echo "excluded: infra node_modules symlinks via ${exclude}"
    fi
}

# 各 packages/*/node_modules を main へ symlink（無い場合のみ）
link_package_node_modules() {
    local wt="$1"
    for pkgdir in "${MAIN_CHECKOUT}"/packages/*/; do
        local pkg
        pkg=$(basename "${pkgdir}")
        local src="${MAIN_CHECKOUT}/packages/${pkg}/node_modules"
        local dst="${wt}/packages/${pkg}/node_modules"
        [[ -d "${src}" ]] || continue
        if [[ -e "${dst}" || -L "${dst}" ]]; then continue; fi
        mkdir -p "$(dirname "${dst}")"
        ln -s "${src}" "${dst}"
        echo "linked: packages/${pkg}/node_modules -> main"
    done
}

# scratch-gui の prepare 生成物（gitignored）を main へ symlink（無い場合のみ・冪等）。
# 理由（Issue #1001）: `packages/scratch-gui` の prepare ライフサイクル
# (`node scripts/prepare.mjs`) が microbit の hex とその URL モジュールをネットワークから
# DL 生成する。軽量 worktree は node_modules を symlink するだけで npm install（=prepare）を
# 走らせないため、以下が空のままだと webpack が resolve 失敗し dev server が
# `Module not found` で落ちる。main の生成物を共有すれば追加 DL 無しで dev server が起動する。
#   - packages/scratch-gui/src/generated       … microbit(-more)-hex-url.cjs
#   - packages/scratch-gui/static/microbit      … scratch-microbit-*.hex
#   - packages/scratch-gui/static/microbitMore  … microbit-mbit-more-v2-*.hex
# --full モードは npm install で prepare が実ファイルを生成するため対象外（軽量モードのみ）。
link_prepare_artifacts() {
    local wt="$1"
    local rel
    for rel in \
        packages/scratch-gui/src/generated \
        packages/scratch-gui/static/microbit \
        packages/scratch-gui/static/microbitMore; do
        local src="${MAIN_CHECKOUT}/${rel}"
        local dst="${wt}/${rel}"
        [[ -d "${src}" ]] || continue
        if [[ -e "${dst}" || -L "${dst}" ]]; then continue; fi
        mkdir -p "$(dirname "${dst}")"
        ln -s "${src}" "${dst}"
        echo "linked: ${rel} -> main"
    done
}

# husky の生成物 `.husky/_` を main へ symlink（冪等）。
# 理由（Issue #1137）: `core.hooksPath=.husky` は共有設定なので `.husky/commit-msg` は
# worktree でも起動するが、フックが source する `.husky/_/husky.sh` は gitignored な
# npm install（=prepare の `husky install`）の生成物で、軽量 worktree には存在しない。
# その結果すべての commit が
#   .husky/commit-msg: 2: .: cannot open .husky/_/husky.sh: No such file
# で失敗する。特に daemon の base 追従（`git merge origin/<base>`）は **merge コミットの
# 作成段階**で落ちるため、コンフリクトが 1 件も無いのに `base-follow-conflict` として
# Blocked になっていた（#957）。main の生成物を共有すればフックがそのまま通る。
# --full モードは npm install が実ファイルを生成するため対象外（軽量モードのみ）。
link_husky_helpers() {
    local wt="$1"
    local src="${MAIN_CHECKOUT}/.husky/_"
    local dst="${wt}/.husky/_"
    # main 側にも無いときは黙って諦めない。ここで沈黙すると worktree の commit が
    # 冒頭の cryptic なエラーで落ち、daemon には base-follow-conflict にしか見えない。
    if [[ ! -d "${src}" ]]; then
        echo "warn: main checkout has no .husky/_ (run 'npm install' in main); commits in the worktree will fail" >&2
        return 0
    fi
    # 解決できない symlink（main 側が作り直された等）は張り直す。放置すると
    # 「存在するのでスキップ」で commit が壊れたままになる。
    if [[ -L "${dst}" && ! -e "${dst}" ]]; then
        rm -f "${dst}"
    fi
    if [[ -e "${dst}" || -L "${dst}" ]]; then return 0; fi
    mkdir -p "$(dirname "${dst}")"
    ln -s "${src}" "${dst}"
    echo "linked: .husky/_ -> main"
}

# infra の依存を worktree 間で共有する置き場（Issue #1456）。
# main が lock と合わないとき worktree ごとに `npm ci` すると、1 worktree あたり約 1.45 GB・約 4 分
# かかっていた（5 プロジェクト分）。lock の内容でキーにした置き場に 1 回だけ入れ、同じ lock の
# worktree（同じ develop から切ったもの）はそこへ symlink して共有する。
#   <WT_ROOT>/.infra-node-modules/<project>-<lock の sha256 先頭16桁>/
#       package.json / package-lock.json（worktree からコピー）+ node_modules/
# 置き場は完成してから rename で置くので、途中の状態は見えない。作成・リンク・掃除は
# 置き場ごとの `<置き場>.lock`（mkdir の排他）の中で行う。
INFRA_STORE="${WT_ROOT}/.infra-node-modules"

# ファイルの sha256（macOS には sha256sum が無いので shasum にフォールバック）
infra_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

# mkdir による排他ロック（Issue #1456）。取れるまで 1 秒ごとに待つ（既定 900 秒まで）。
# 持ち主の pid が死んでいるか、pid を書く前に落ちたまま 1 分経ったロックは奪う。
acquire_dir_lock() {
    local lockdir="$1" max="${AUTOPILOT_INFRA_LOCK_WAIT:-900}" waited=0 owner
    while ! mkdir "${lockdir}" 2>/dev/null; do
        owner=$(cat "${lockdir}/pid" 2>/dev/null || true)
        if [[ -n "${owner}" ]] && ! kill -0 "${owner}" 2>/dev/null; then
            echo "info: removing stale lock ${lockdir} (pid ${owner} is gone)" >&2
            rm -rf "${lockdir}"
            continue
        fi
        if [[ -z "${owner}" && -n "$(find "${lockdir}" -maxdepth 0 -mmin +1 2>/dev/null)" ]]; then
            rm -rf "${lockdir}"
            continue
        fi
        (( waited >= max )) && return 1
        sleep 1
        waited=$((waited + 1))
    done
    echo "${BASHPID}" > "${lockdir}/pid"
}

release_dir_lock() {
    rm -rf "$1"
}

# lock に合う置き場を用意して、その node_modules のパスを stdout に出す（ロックの中で呼ぶ）。
# 既にあり lock と一致すれば何もしない。無い・壊れていれば一時 dir で `npm ci` して rename する。
ensure_infra_store() {
    local compare="$1" proj_dir="$2" store="$3"
    local lock="${proj_dir}/package-lock.json"
    if [[ -d "${store}" ]] && node "${compare}" "${store}/node_modules/.package-lock.json" "${lock}" 2>/dev/null; then
        echo "${store}/node_modules"
        return 0
    fi
    rm -rf "${store}"
    local tmp="${store}.tmp.${BASHPID}"
    rm -rf "${tmp}"
    mkdir -p "${tmp}"
    cp "${proj_dir}/package.json" "${lock}" "${tmp}/"
    if ! ( cd "${tmp}" && npm ci --no-audit --no-fund >/dev/null ); then
        rm -rf "${tmp}"
        return 1
    fi
    mv "${tmp}" "${store}"
    echo "${store}/node_modules"
}

# infra/<project>/node_modules を worktree の lock に合わせて用意する（冪等・Issue #1454 / #1456）。
# 理由: infra の CDK プロジェクトは npm workspaces の外にあり、root / packages の
# node_modules の symlink では入らない。worker が main のものへ手で symlink すると、
# main checkout（人間と共有）が develop より古いとき古い依存でテストが走り、worktree の
# lock に足された依存（#1442 の `@anthropic-ai/sdk` 等）が「Cannot find module」になる。
# そこで main の `node_modules/.package-lock.json`（npm が入れた版の記録）と worktree の
# `package-lock.json` を tools/autopilot/src/lockfile.js で比べ:
#   - 一致する → main へ symlink（軽量モードの考え方どおり共有）
#   - 一致しない / main に node_modules が無い → lock でキーにした共有の置き場
#     （INFRA_STORE）へ symlink。置き場が無ければそこで 1 回だけ `npm ci`（lock 固定の版を
#     入れるので 3 日ルールに反しない）
#   - 置き場のロックが取れない（待ちの上限）→ 従来どおり worktree で `npm ci`
# 再準備時は既存の symlink を張り直して判定し直す（base 追従で lock が変わった場合）。
# 実体のディレクトリは、それ自体が lock と一致すればそのまま使う。
# npm ci が失敗しても worktree の作成は止めない（infra を触らない Issue まで巻き込まない）。
link_infra_node_modules() {
    local wt="$1"
    # このスクリプトと同じ checkout の比較処理を使う（無ければ worktree 側）
    local compare
    compare="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/tools/autopilot/src/lockfile.js"
    [[ -f "${compare}" ]] || compare="${wt}/tools/autopilot/src/lockfile.js"
    if [[ ! -f "${compare}" ]]; then
        echo "warn: lockfile.js not found; skipping infra node_modules setup" >&2
        return 0
    fi
    local lock
    for lock in "${wt}"/infra/*/package-lock.json; do
        [[ -f "${lock}" ]] || continue
        local proj_dir proj src dst
        proj_dir=$(dirname "${lock}")
        proj=$(basename "${proj_dir}")
        src="${MAIN_CHECKOUT}/infra/${proj}/node_modules"
        dst="${proj_dir}/node_modules"
        if [[ -L "${dst}" ]]; then
            rm -f "${dst}"
        elif [[ -d "${dst}" ]]; then
            if node "${compare}" "${dst}/.package-lock.json" "${lock}" 2>/dev/null; then
                continue
            fi
        fi
        local why=""
        if [[ -d "${src}" ]] && why=$(node "${compare}" "${src}/.package-lock.json" "${lock}" 2>&1); then
            # lock と合わない実体が残っていると `ln -s` がその中に node_modules/node_modules を作る
            rm -rf "${dst}"
            ln -s "${src}" "${dst}"
            echo "linked: infra/${proj}/node_modules -> main"
            continue
        fi
        echo "info: infra/${proj}: main node_modules does not match the lock (${why:-missing}); using the shared store"
        local store target
        store="${INFRA_STORE}/${proj}-$(infra_sha256 "${lock}" | cut -c1-16)"
        mkdir -p "${INFRA_STORE}"
        if acquire_dir_lock "${store}.lock"; then
            if target=$(ensure_infra_store "${compare}" "${proj_dir}" "${store}"); then
                rm -rf "${dst}"
                # 掃除（prune_infra_store）とすれ違わないよう、リンクもロックの中で張る
                ln -s "${target}" "${dst}"
                release_dir_lock "${store}.lock"
                echo "linked: infra/${proj}/node_modules -> ${store}"
            else
                release_dir_lock "${store}.lock"
                echo "warn: npm ci failed for infra/${proj} in ${store}; its tests may not run in this worktree" >&2
            fi
            continue
        fi
        echo "warn: could not lock ${store}; running npm ci in the worktree" >&2
        rm -rf "${dst}"
        if ! ( cd "${proj_dir}" && npm ci --no-audit --no-fund >/dev/null ); then
            echo "warn: npm ci failed in infra/${proj}; its tests may not run in this worktree" >&2
            continue
        fi
        echo "installed: infra/${proj}/node_modules (npm ci)"
    done
}

# 登録済みの worktree のパス（main checkout を含む）を 1 行ずつ出す
list_worktree_paths() {
    local list
    list=$(git -C "${MAIN_CHECKOUT}" worktree list --porcelain)
    sed -n 's/^worktree //p' <<<"${list}"
}

# 置き場の node_modules をどれかの worktree の infra/*/node_modules が指しているか
infra_store_referenced() {
    local target="$1/node_modules" w link
    while IFS= read -r w; do
        [[ -n "${w}" ]] || continue
        for link in "${w}"/infra/*/node_modules; do
            [[ -L "${link}" && "$(readlink "${link}")" == "${target}" ]] && return 0
        done
    done < <(list_worktree_paths)
    return 1
}

# どの worktree からも使われていない置き場を消す（Issue #1456）。worktree の片付け（#1362・
# daemon の cleanupIssueWorktree と `remove`）の後に呼ぶ。使用中（ロック中）の置き場は飛ばす。
# 持ち主の死んだ作りかけ（`.tmp.<pid>`）も消す。
prune_infra_store() {
    [[ -d "${INFRA_STORE}" ]] || return 0
    local entry name pid
    for entry in "${INFRA_STORE}"/*; do
        [[ -d "${entry}" ]] || continue
        name=$(basename "${entry}")
        case "${name}" in
            *.lock) continue ;;
            *.tmp.*)
                pid="${name##*.tmp.}"
                if ! kill -0 "${pid}" 2>/dev/null; then
                    rm -rf "${entry}"
                    echo "removed: stale partial install ${entry}"
                fi
                continue
                ;;
        esac
        AUTOPILOT_INFRA_LOCK_WAIT=0 acquire_dir_lock "${entry}.lock" || continue
        if ! infra_store_referenced "${entry}"; then
            rm -rf "${entry}"
            echo "removed: unused infra store ${entry}"
        fi
        release_dir_lock "${entry}.lock"
    done
}

cmd_create() {
    local issue="$1"; shift || true
    local base="origin/develop"
    local full=false
    local explicit_branch=""   # --branch <name>: 既存ブランチを checkout
    local pr_number=""         # --pr <number>: PR のヘッドブランチを checkout
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) full=true ;;
            --branch) explicit_branch="$2"; shift ;;
            --pr) pr_number="$2"; shift ;;
            *) base="$1" ;;
        esac
        shift
    done
    [[ -n "${issue}" ]] || { echo "usage: autopilot-worktree create <issue> [base-ref] [--full] [--branch <name>] [--pr <n>]" >&2; exit 2; }

    # --pr: PR のヘッドブランチ名を解決（address-review 等で既存 PR ブランチを使う）
    if [[ -n "${pr_number}" ]]; then
        local tok; tok="$("${MAIN_CHECKOUT}/bin/bot-token")"
        explicit_branch="$(GH_TOKEN="${tok}" gh pr view "${pr_number}" --repo smalruby/smalruby3-editor --json headRefName -q .headRefName)"
        [[ -n "${explicit_branch}" ]] || { echo "error: could not resolve PR #${pr_number} head branch" >&2; exit 1; }
    fi

    local wt branch
    wt=$(wt_path "${issue}")
    if [[ -n "${explicit_branch}" ]]; then branch="${explicit_branch}"; else branch=$(wt_branch "${issue}"); fi

    # 自己修復: worktree の実体が消えても .git/worktrees のメタデータだけ残ると
    # 「登録あり→再準備→cd 失敗」になる（devpod rebuild で /root 配下が消えた等）。
    # 毎回 prune で実体の無い登録を掃除し、親 dir を用意してから既存判定する。
    mkdir -p "${WT_ROOT}"
    git -C "${MAIN_CHECKOUT}" worktree prune >/dev/null 2>&1 || true

    git -C "${MAIN_CHECKOUT}" fetch -p origin develop >/dev/null 2>&1 || true
    if [[ -n "${explicit_branch}" ]]; then
        git -C "${MAIN_CHECKOUT}" fetch origin "${explicit_branch}" >/dev/null 2>&1 || true
    fi
    # 明示 base（develop 以外。EPIC サブ Issue 等）はそのブランチを fetch し origin/ ref に正規化
    if [[ "${base}" != "origin/develop" ]]; then
        local base_branch="${base#origin/}"
        git -C "${MAIN_CHECKOUT}" fetch origin "${base_branch}" >/dev/null 2>&1 || true
        base="origin/${base_branch}"
    fi

    if is_registered_worktree "${wt}"; then
        echo "info: worktree already exists: ${wt} (re-preparing)"
    elif git -C "${MAIN_CHECKOUT}" show-ref --verify --quiet "refs/heads/${branch}"; then
        git_wt_add_retry "${wt}" "${branch}"
    elif [[ -n "${explicit_branch}" ]] && git -C "${MAIN_CHECKOUT}" show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
        # 既存リモートブランチ（既存ブランチ / PR ヘッド）を追跡 checkout
        git_wt_add_retry -b "${branch}" "${wt}" "origin/${branch}"
    elif [[ -n "${explicit_branch}" ]]; then
        echo "error: branch not found locally or on origin: ${branch}" >&2; exit 1
    else
        git_wt_add_retry -b "${branch}" "${wt}" "${base}"
    fi

    if [[ "${full}" == "true" ]]; then
        echo "=== full setup (npm install + build:dev) in ${wt} ==="
        ( cd "${wt}" && bin/setup-worktree )
    else
        # lightweight: copy .env.* + symlink root node_modules（sync-worktree-env）
        ( cd "${wt}" && "${MAIN_CHECKOUT}/bin/sync-worktree-env" )
        # 各 package の node_modules も symlink
        link_package_node_modules "${wt}"
        # scratch-gui の prepare 生成物（microbit hex 等）も main へ symlink（#1001）
        link_prepare_artifacts "${wt}"
        # husky の生成物（commit-msg フックが source する husky.sh）も main へ symlink（#1137）
        link_husky_helpers "${wt}"
        # infra の依存は worktree の lock に合わせる（一致すれば symlink・違えば npm ci。#1454）
        link_infra_node_modules "${wt}"
    fi

    # symlink した node_modules / prepare 生成物を確実に無視させる保険（base が古くても効く）
    exclude_node_modules "${wt}"

    echo ""
    echo "ready: ${wt}"
    echo "branch: ${branch}"
}

cmd_path() {
    local issue="$1"
    [[ -n "${issue}" ]] || { echo "usage: autopilot-worktree path <issue>" >&2; exit 2; }
    wt_path "${issue}"
}

cmd_remove() {
    local issue="$1"; shift || true
    local del_branch=false
    [[ "${1:-}" == "--delete-branch" ]] && del_branch=true
    [[ -n "${issue}" ]] || { echo "usage: autopilot-worktree remove <issue> [--delete-branch]" >&2; exit 2; }
    local wt branch
    wt=$(wt_path "${issue}")
    branch=$(wt_branch "${issue}")
    git -C "${MAIN_CHECKOUT}" worktree remove --force "${wt}" 2>/dev/null \
        && echo "removed worktree: ${wt}" || echo "info: worktree not found: ${wt}"
    # どこからも使われなくなった infra の共有置き場を掃除する（#1456）
    prune_infra_store || true
    if [[ "${del_branch}" == "true" ]]; then
        git -C "${MAIN_CHECKOUT}" branch -D "${branch}" 2>/dev/null \
            && echo "deleted branch: ${branch}" || echo "info: branch not found: ${branch}"
    fi
}

cmd_list() {
    git -C "${MAIN_CHECKOUT}" worktree list | grep -E "autopilot-worktrees|${BRANCH_PREFIX%/*}" || true
}

case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    path)   shift; cmd_path "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    list)   shift; cmd_list "$@" ;;
    prune-infra-store) shift; prune_infra_store ;;
    *)
        echo "usage: autopilot-worktree {create|path|remove|list|prune-infra-store} ..." >&2
        echo "  create <issue> [base-ref] [--full] [--branch <name>] [--pr <n>]" >&2
        echo "  path <issue>" >&2
        echo "  remove <issue> [--delete-branch]" >&2
        echo "  list" >&2
        echo "  prune-infra-store" >&2
        exit 2
        ;;
esac
