#!/usr/bin/env bash
# bin/autopilot-worktree — しゅっと作れる軽量 worktree（autopilot 用）。
#
# autopilot は Issue ごとに git worktree を切って隔離作業する。毎回
# `npm install` / `build:dev` していたら遅いので、**ビルド成果物は共有**し、
# **状態 (.env) はコピー**して、最小の手順で即作業可能にする。
#
# 仕組み（なぜ install/build が要らないか）:
#   - root `node_modules` を main checkout のものへ symlink（devpod の named
#     volume 実体を共有）。npm workspaces のリンク `node_modules/@smalruby/<pkg>`
#     は相対 symlink なので、main checkout の `packages/<pkg>`（dist ビルド済み）
#     に解決される。→ worktree 側で build:dev 不要。
#   - 各 `packages/<pkg>/node_modules` も main へ symlink（scratch-gui の
#     scratch-blocks 等 local 依存の解決用）。
#   - `.env.*` は `bin/sync-worktree-env` で**コピー**（symlink にしない:
#     誤書き込みで main の秘密を壊さないため。`.claude/rules/env-file.md`）。
#   - `.husky/_` も main へ symlink。commit-msg フック（共有 `core.hooksPath`）が
#     source する husky.sh は npm install の生成物なので、無いと commit / merge が
#     まるごと失敗する（Issue #1137）。
#
# 制約（lightweight モードの前提）:
#   - **単一パッケージのソース編集**を想定。`@smalruby/<pkg>` は main checkout に
#     解決されるため、worktree で scratch-vm のソースを編集しても scratch-gui の
#     テストはそれを見ない（main の dist を見る）。
#   - **クロスパッケージのソース編集**（編集した sibling を再ビルドして参照させたい）
#     場合は `--full` を使う（worktree 内で実 npm install + build:dev、symlink 無し）。
#
# Usage:
#   bin/autopilot-worktree create <issue> [base-ref]   # 既定 base: origin/develop（新ブランチ）
#   bin/autopilot-worktree create <issue> --full        # 重い完全セットアップ
#   bin/autopilot-worktree create <issue> --branch <name>  # 既存ブランチを checkout
#   bin/autopilot-worktree create <issue> --pr <number>    # PR のヘッドブランチを checkout（address-review 用）
#   bin/autopilot-worktree path <issue>                 # worktree パスを表示
#   bin/autopilot-worktree remove <issue> [--delete-branch]
#   bin/autopilot-worktree list
#
# 環境変数:
#   AUTOPILOT_WORKTREE_ROOT  worktree を作る親dir
#                            （既定: <main checkout>/.autopilot-worktrees）
#                            既定はリポジトリ直下（gitignore 済み）。devpod では /app が
#                            bind mount で永続するため、rebuild しても worktree の実体と
#                            .git/worktrees メタデータが同じ mount 上で同期し続ける。
#                            （旧既定 $HOME/autopilot-worktrees は /root 配下 = ephemeral で
#                             rebuild ごとに消え、stale 登録が残って dispatch が壊れていた）
#   AUTOPILOT_BRANCH_PREFIX  ブランチ接頭辞（既定: topic/autopilot-）
set -euo pipefail

MAIN_CHECKOUT=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [[ -z "${MAIN_CHECKOUT}" ]]; then
    echo "error: not inside a git repository" >&2
    exit 1
fi
# worktree の中で実行された場合も main checkout を基準にする
GIT_COMMON_DIR=$(git rev-parse --git-common-dir)
GIT_COMMON_ABS=$(cd "${GIT_COMMON_DIR}" && pwd)
MAIN_CHECKOUT=$(dirname "${GIT_COMMON_ABS}")

WT_ROOT="${AUTOPILOT_WORKTREE_ROOT:-${MAIN_CHECKOUT}/.autopilot-worktrees}"
BRANCH_PREFIX="${AUTOPILOT_BRANCH_PREFIX:-topic/autopilot-}"

wt_path() { echo "${WT_ROOT}/issue-$1"; }
wt_branch() { echo "${BRANCH_PREFIX}$1"; }

# `git worktree add -b` は新ブランチの upstream 設定で共有 .git/config をロックする。
# daemon が複数 Issue を同時ディスパッチすると複数の `autopilot-worktree create` が並行し、
# `could not lock config file .git/config: File exists` で worktree 作成が失敗する（#681/#958）。
# ロック競合はジッタ付きで数回リトライして吸収する（それ以外のエラーはそのまま返す）。
git_wt_add_retry() {
    local attempt out rc
    for attempt in 1 2 3 4 5 6; do
        if out=$(git -C "${MAIN_CHECKOUT}" worktree add "$@" 2>&1); then
            [[ -n "${out}" ]] && printf '%s\n' "${out}"
            return 0
        fi
        rc=$?
        if printf '%s' "${out}" | grep -q "could not lock config file"; then
            echo "info: .git/config ロック競合で worktree add 失敗、リトライ ${attempt}/6" >&2
            sleep "0.$((RANDOM % 7 + 3))"   # 0.3〜0.9s のジッタで再衝突を避ける
            continue
        fi
        printf '%s\n' "${out}" >&2
        return "${rc}"
    done
    echo "error: worktree add が .git/config ロック競合で 6 回失敗しました（並行作成の輻輳）" >&2
    printf '%s\n' "${out}" >&2
    return 1
}

# worktree の git exclude に node_modules を追記（冪等・コミット不要）。
# 理由: node_modules を main へ symlink して共有するが、古い base ブランチの
# `.gitignore` は `node_modules/`（末尾スラッシュ=ディレクトリのみ）で symlink を
# 無視できず、`git add -A` で誤ってステージされる（Issue #801 / PR #800）。
# `.gitignore` 側も symlink を無視するよう修正済みだが、修正前の base から切った
# worktree でも確実に無視されるよう保険として exclude にも入れる。
# info/exclude は共有 (git-common-dir) なので 1 度書けば全 worktree に効く。
exclude_node_modules() {
    local wt="$1"
    local exclude
    exclude=$(cd "${wt}" && git rev-parse --git-path info/exclude 2>/dev/null) || return 0
    [[ -n "${exclude}" ]] || return 0
    mkdir -p "$(dirname "${exclude}")"
    touch "${exclude}"

    local marker="# autopilot: ignore shared node_modules symlinks (Issue #801)"
    if ! grep -qxF "${marker}" "${exclude}" 2>/dev/null; then
        {
            echo "${marker}"
            echo "node_modules"
            echo "packages/*/node_modules"
        } >> "${exclude}"
        echo "excluded: node_modules symlinks via ${exclude}"
    fi

    # scratch-gui の prepare 生成物 symlink も同様に保険で無視する（Issue #1001）。
    # これらは packages/scratch-gui/.gitignore が末尾スラッシュ（`src/generated/` 等）で
    # 無視するが、末尾スラッシュはディレクトリのみに一致し symlink には効かない（#801 と同型）。
    # 末尾スラッシュ無し・root 相対のパターンで symlink も確実に無視させる。
    local prep_marker="# autopilot: ignore shared scratch-gui prepare artifact symlinks (Issue #1001)"
    if ! grep -qxF "${prep_marker}" "${exclude}" 2>/dev/null; then
        {
            echo "${prep_marker}"
            echo "packages/scratch-gui/src/generated"
            echo "packages/scratch-gui/static/microbit"
            echo "packages/scratch-gui/static/microbitMore"
        } >> "${exclude}"
        echo "excluded: scratch-gui prepare artifact symlinks via ${exclude}"
    fi

    # husky の生成物 symlink も同様（Issue #1137）。husky は `.husky/_/.gitignore`（中身は `*`）
    # で自分自身を無視するが、git は **symlink を辿ってその .gitignore を読まない**ため、
    # `.husky/_` symlink は未追跡として現れてしまう（#801 / #1001 と同型の抜け）。
    local husky_marker="# autopilot: ignore shared husky helper symlink (Issue #1137)"
    if ! grep -qxF "${husky_marker}" "${exclude}" 2>/dev/null; then
        {
            echo "${husky_marker}"
            echo ".husky/_"
        } >> "${exclude}"
        echo "excluded: husky helper symlink via ${exclude}"
    fi
}

# 各 packages/*/node_modules を main へ symlink（無い場合のみ）
link_package_node_modules() {
    local wt="$1"
    for pkgdir in "${MAIN_CHECKOUT}"/packages/*/; do
        local pkg
        pkg=$(basename "${pkgdir}")
        local src="${MAIN_CHECKOUT}/packages/${pkg}/node_modules"
        local dst="${wt}/packages/${pkg}/node_modules"
        [[ -d "${src}" ]] || continue
        if [[ -e "${dst}" || -L "${dst}" ]]; then continue; fi
        mkdir -p "$(dirname "${dst}")"
        ln -s "${src}" "${dst}"
        echo "linked: packages/${pkg}/node_modules -> main"
    done
}

# scratch-gui の prepare 生成物（gitignored）を main へ symlink（無い場合のみ・冪等）。
# 理由（Issue #1001）: `packages/scratch-gui` の prepare ライフサイクル
# (`node scripts/prepare.mjs`) が microbit の hex とその URL モジュールをネットワークから
# DL 生成する。軽量 worktree は node_modules を symlink するだけで npm install（=prepare）を
# 走らせないため、以下が空のままだと webpack が resolve 失敗し dev server が
# `Module not found` で落ちる。main の生成物を共有すれば追加 DL 無しで dev server が起動する。
#   - packages/scratch-gui/src/generated       … microbit(-more)-hex-url.cjs
#   - packages/scratch-gui/static/microbit      … scratch-microbit-*.hex
#   - packages/scratch-gui/static/microbitMore  … microbit-mbit-more-v2-*.hex
# --full モードは npm install で prepare が実ファイルを生成するため対象外（軽量モードのみ）。
link_prepare_artifacts() {
    local wt="$1"
    local rel
    for rel in \
        packages/scratch-gui/src/generated \
        packages/scratch-gui/static/microbit \
        packages/scratch-gui/static/microbitMore; do
        local src="${MAIN_CHECKOUT}/${rel}"
        local dst="${wt}/${rel}"
        [[ -d "${src}" ]] || continue
        if [[ -e "${dst}" || -L "${dst}" ]]; then continue; fi
        mkdir -p "$(dirname "${dst}")"
        ln -s "${src}" "${dst}"
        echo "linked: ${rel} -> main"
    done
}

# husky の生成物 `.husky/_` を main へ symlink（冪等）。
# 理由（Issue #1137）: `core.hooksPath=.husky` は共有設定なので `.husky/commit-msg` は
# worktree でも起動するが、フックが source する `.husky/_/husky.sh` は gitignored な
# npm install（=prepare の `husky install`）の生成物で、軽量 worktree には存在しない。
# その結果すべての commit が
#   .husky/commit-msg: 2: .: cannot open .husky/_/husky.sh: No such file
# で失敗する。特に daemon の base 追従（`git merge origin/<base>`）は **merge コミットの
# 作成段階**で落ちるため、コンフリクトが 1 件も無いのに `base-follow-conflict` として
# Blocked になっていた（#957）。main の生成物を共有すればフックがそのまま通る。
# --full モードは npm install が実ファイルを生成するため対象外（軽量モードのみ）。
link_husky_helpers() {
    local wt="$1"
    local src="${MAIN_CHECKOUT}/.husky/_"
    local dst="${wt}/.husky/_"
    # main 側にも無いときは黙って諦めない。ここで沈黙すると worktree の commit が
    # 冒頭の cryptic なエラーで落ち、daemon には base-follow-conflict にしか見えない。
    if [[ ! -d "${src}" ]]; then
        echo "warn: main checkout has no .husky/_ (run 'npm install' in main); commits in the worktree will fail" >&2
        return 0
    fi
    # 解決できない symlink（main 側が作り直された等）は張り直す。放置すると
    # 「存在するのでスキップ」で commit が壊れたままになる。
    if [[ -L "${dst}" && ! -e "${dst}" ]]; then
        rm -f "${dst}"
    fi
    if [[ -e "${dst}" || -L "${dst}" ]]; then return 0; fi
    mkdir -p "$(dirname "${dst}")"
    ln -s "${src}" "${dst}"
    echo "linked: .husky/_ -> main"
}

cmd_create() {
    local issue="$1"; shift || true
    local base="origin/develop"
    local full=false
    local explicit_branch=""   # --branch <name>: 既存ブランチを checkout
    local pr_number=""         # --pr <number>: PR のヘッドブランチを checkout
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) full=true ;;
            --branch) explicit_branch="$2"; shift ;;
            --pr) pr_number="$2"; shift ;;
            *) base="$1" ;;
        esac
        shift
    done
    [[ -n "${issue}" ]] || { echo "usage: autopilot-worktree create <issue> [base-ref] [--full] [--branch <name>] [--pr <n>]" >&2; exit 2; }

    # --pr: PR のヘッドブランチ名を解決（address-review 等で既存 PR ブランチを使う）
    if [[ -n "${pr_number}" ]]; then
        local tok; tok="$("${MAIN_CHECKOUT}/bin/bot-token")"
        explicit_branch="$(GH_TOKEN="${tok}" gh pr view "${pr_number}" --repo smalruby/smalruby3-editor --json headRefName -q .headRefName)"
        [[ -n "${explicit_branch}" ]] || { echo "error: could not resolve PR #${pr_number} head branch" >&2; exit 1; }
    fi

    local wt branch
    wt=$(wt_path "${issue}")
    if [[ -n "${explicit_branch}" ]]; then branch="${explicit_branch}"; else branch=$(wt_branch "${issue}"); fi

    # 自己修復: worktree の実体が消えても .git/worktrees のメタデータだけ残ると
    # 「登録あり→再準備→cd 失敗」になる（devpod rebuild で /root 配下が消えた等）。
    # 毎回 prune で実体の無い登録を掃除し、親 dir を用意してから既存判定する。
    mkdir -p "${WT_ROOT}"
    git -C "${MAIN_CHECKOUT}" worktree prune >/dev/null 2>&1 || true

    git -C "${MAIN_CHECKOUT}" fetch -p origin develop >/dev/null 2>&1 || true
    if [[ -n "${explicit_branch}" ]]; then
        git -C "${MAIN_CHECKOUT}" fetch origin "${explicit_branch}" >/dev/null 2>&1 || true
    fi
    # 明示 base（develop 以外。EPIC サブ Issue 等）はそのブランチを fetch し origin/ ref に正規化
    if [[ "${base}" != "origin/develop" ]]; then
        local base_branch="${base#origin/}"
        git -C "${MAIN_CHECKOUT}" fetch origin "${base_branch}" >/dev/null 2>&1 || true
        base="origin/${base_branch}"
    fi

    if git -C "${MAIN_CHECKOUT}" worktree list --porcelain | grep -qx "worktree ${wt}"; then
        echo "info: worktree already exists: ${wt} (re-preparing)"
    elif git -C "${MAIN_CHECKOUT}" show-ref --verify --quiet "refs/heads/${branch}"; then
        git_wt_add_retry "${wt}" "${branch}"
    elif [[ -n "${explicit_branch}" ]] && git -C "${MAIN_CHECKOUT}" show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
        # 既存リモートブランチ（既存ブランチ / PR ヘッド）を追跡 checkout
        git_wt_add_retry -b "${branch}" "${wt}" "origin/${branch}"
    elif [[ -n "${explicit_branch}" ]]; then
        echo "error: branch not found locally or on origin: ${branch}" >&2; exit 1
    else
        git_wt_add_retry -b "${branch}" "${wt}" "${base}"
    fi

    if [[ "${full}" == "true" ]]; then
        echo "=== full setup (npm install + build:dev) in ${wt} ==="
        ( cd "${wt}" && bin/setup-worktree )
    else
        # lightweight: copy .env.* + symlink root node_modules（sync-worktree-env）
        ( cd "${wt}" && "${MAIN_CHECKOUT}/bin/sync-worktree-env" )
        # 各 package の node_modules も symlink
        link_package_node_modules "${wt}"
        # scratch-gui の prepare 生成物（microbit hex 等）も main へ symlink（#1001）
        link_prepare_artifacts "${wt}"
        # husky の生成物（commit-msg フックが source する husky.sh）も main へ symlink（#1137）
        link_husky_helpers "${wt}"
    fi

    # symlink した node_modules / prepare 生成物を確実に無視させる保険（base が古くても効く）
    exclude_node_modules "${wt}"

    echo ""
    echo "ready: ${wt}"
    echo "branch: ${branch}"
}

cmd_path() {
    local issue="$1"
    [[ -n "${issue}" ]] || { echo "usage: autopilot-worktree path <issue>" >&2; exit 2; }
    wt_path "${issue}"
}

cmd_remove() {
    local issue="$1"; shift || true
    local del_branch=false
    [[ "${1:-}" == "--delete-branch" ]] && del_branch=true
    [[ -n "${issue}" ]] || { echo "usage: autopilot-worktree remove <issue> [--delete-branch]" >&2; exit 2; }
    local wt branch
    wt=$(wt_path "${issue}")
    branch=$(wt_branch "${issue}")
    git -C "${MAIN_CHECKOUT}" worktree remove --force "${wt}" 2>/dev/null \
        && echo "removed worktree: ${wt}" || echo "info: worktree not found: ${wt}"
    if [[ "${del_branch}" == "true" ]]; then
        git -C "${MAIN_CHECKOUT}" branch -D "${branch}" 2>/dev/null \
            && echo "deleted branch: ${branch}" || echo "info: branch not found: ${branch}"
    fi
}

cmd_list() {
    git -C "${MAIN_CHECKOUT}" worktree list | grep -E "autopilot-worktrees|${BRANCH_PREFIX%/*}" || true
}

case "${1:-}" in
    create) shift; cmd_create "$@" ;;
    path)   shift; cmd_path "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    list)   shift; cmd_list "$@" ;;
    *)
        echo "usage: autopilot-worktree {create|path|remove|list} ..." >&2
        echo "  create <issue> [base-ref] [--full] [--branch <name>] [--pr <n>]" >&2
        echo "  path <issue>" >&2
        echo "  remove <issue> [--delete-branch]" >&2
        echo "  list" >&2
        exit 2
        ;;
esac
