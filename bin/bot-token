#!/usr/bin/env node
/* eslint-disable */
/**
 * bot-token — Mint (and cache) a GitHub App installation access token, and
 * optionally configure repo-local git to commit/push as the App's bot identity.
 *
 * Secrets live OUTSIDE git (default ~/.config/smalruby-bot/). This script holds
 * NO secrets and is safe to commit.
 *
 * Config dir (default ~/.config/smalruby-bot, override with SMALRUBY_BOT_DIR):
 *   private-key.pem   the GitHub App private key (optional if fetched from AWS)
 *   config            shell-style KEY=VALUE with:
 *                       APP_ID=<numeric app id>
 *                       INSTALLATION_ID=<numeric installation id>
 *                       APP_SLUG=<app slug, e.g. smalruby3-editor-bot>
 *                       PRIVATE_KEY_SECRET_ID=<AWS Secrets Manager secret id/ARN> (optional)
 *                       AWS_PROFILE=<profile for the aws call> (optional)
 *                       AWS_REGION=<region for the aws call> (optional)
 *   token.json        (auto) cached installation token + expiry
 *
 * Private key resolution (無人運用・生 .pem の各自配付を廃止):
 *   1. PRIVATE_KEY_SECRET_ID があれば AWS Secrets Manager から取得（aws CLI 経由。
 *      SSO 失効時は再認証手順を stderr に出して失敗する）
 *   2. 取得に失敗し、ローカル private-key.pem があれば warn してフォールバック
 *   3. どちらも無ければエラー
 *
 * Usage:
 *   bin/bot-token                 print a valid installation token (refresh if stale)
 *   bin/bot-token --print-jwt     print a short-lived App JWT (debug)
 *   bin/bot-token --installations list installations visible to the App (needs APP_ID only)
 *   bin/bot-token --bot-email     print the bot commit email (<id>+<slug>[bot]@users.noreply.github.com)
 *   bin/bot-token --whoami        show which identity gh would use with this token
 *
 * NOTE: This script never mutates shared git config. To act AS the bot for a
 * single git command, use `bin/bot-git` (injects bot identity + credential via
 * `-c` for that invocation only). Plain `git` stays human-owned. For gh, use
 * `GH_TOKEN="$(bin/bot-token)" gh ...`.
 */

'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const { execFileSync } = require('child_process');

const DIR = process.env.SMALRUBY_BOT_DIR || path.join(os.homedir(), '.config', 'smalruby-bot');
const CACHE_DIR = process.env.SMALRUBY_BOT_CACHE || path.join(os.homedir(), '.cache', 'smalruby-bot');
const PEM_PATH = path.join(DIR, 'private-key.pem');
const CONFIG_PATH = path.join(DIR, 'config');
const TOKEN_CACHE = path.join(CACHE_DIR, 'token.json');

function die(msg) {
    process.stderr.write(`bot-token: ${msg}\n`);
    process.exit(1);
}

function readConfig() {
    const cfg = {};
    if (fs.existsSync(CONFIG_PATH)) {
        for (const line of fs.readFileSync(CONFIG_PATH, 'utf8').split('\n')) {
            const m = line.match(/^\s*([A-Z_]+)\s*=\s*(.*?)\s*$/);
            if (m) cfg[m[1]] = m[2].replace(/^["']|["']$/g, '');
        }
    }
    // env overrides
    for (const k of ['APP_ID', 'INSTALLATION_ID', 'APP_SLUG', 'PRIVATE_KEY_SECRET_ID']) {
        if (process.env[`SMALRUBY_BOT_${k}`]) cfg[k] = process.env[`SMALRUBY_BOT_${k}`];
    }
    return cfg;
}

function b64url(buf) {
    return Buffer.from(buf).toString('base64').replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

function makeJwt(appId, pem) {
    const now = Math.floor(Date.now() / 1000);
    const header = b64url(JSON.stringify({ alg: 'RS256', typ: 'JWT' }));
    // iat backdated 60s for clock skew; exp 9 min (<10 min max)
    const payload = b64url(JSON.stringify({ iat: now - 60, exp: now + 540, iss: String(appId) }));
    const signer = crypto.createSign('RSA-SHA256');
    signer.update(`${header}.${payload}`);
    const sig = b64url(signer.sign(pem));
    return `${header}.${payload}.${sig}`;
}

async function api(urlPath, { method = 'GET', auth, body } = {}) {
    const res = await fetch(`https://api.github.com${urlPath}`, {
        method,
        headers: {
            Authorization: `Bearer ${auth}`,
            Accept: 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
            'User-Agent': 'smalruby-bot-token',
        },
        body: body ? JSON.stringify(body) : undefined,
    });
    const text = await res.text();
    let json;
    try { json = text ? JSON.parse(text) : {}; } catch { json = { raw: text }; }
    if (!res.ok) die(`${method} ${urlPath} -> ${res.status}: ${json.message || text}`);
    return json;
}

/**
 * AWS Secrets Manager から GitHub App 秘密鍵 (PEM) を取得する。
 * SecretString は生 PEM か、{"privateKey": "..."} 形式の JSON を受け付ける。
 * SSO 失効らしいエラーは再認証手順を含むメッセージで die する
 * (daemon はこの失敗を検知して auto-pause し、モニタで再認証を促す)。
 */
function fetchPemFromSecretsManager(cfg) {
    const env = { ...process.env };
    if (cfg.AWS_PROFILE && !env.AWS_PROFILE) env.AWS_PROFILE = cfg.AWS_PROFILE;
    if (cfg.AWS_REGION && !env.AWS_REGION) env.AWS_REGION = cfg.AWS_REGION;
    let out;
    try {
        out = execFileSync('aws', [
            'secretsmanager', 'get-secret-value',
            '--secret-id', cfg.PRIVATE_KEY_SECRET_ID,
            '--query', 'SecretString', '--output', 'text',
        ], { encoding: 'utf8', env, stdio: ['ignore', 'pipe', 'pipe'] });
    } catch (e) {
        const detail = `${(e.stderr || '').toString()}\n${e.message || ''}`;
        if (/sso|token.*(expired|invalid)|expired.*token|security token|Unable to locate credentials/i.test(detail)) {
            throw new Error(
                'AWS 認証が失効/未設定のため Secrets Manager から秘密鍵を取得できません。' +
                '`aws sso login --sso-session smalruby --use-device-code` で再認証してください。' +
                ` (${detail.trim().split('\n')[0]})`,
            );
        }
        throw new Error(`aws secretsmanager get-secret-value failed: ${detail.trim().split('\n')[0]}`);
    }
    let pem = out.trim();
    if (pem.startsWith('{')) {
        try {
            const j = JSON.parse(pem);
            pem = j.privateKey || j.private_key || j.pem || '';
        } catch { /* fall through to validation */ }
    }
    if (!pem.includes('BEGIN') || !pem.includes('PRIVATE KEY')) {
        throw new Error(`secret ${cfg.PRIVATE_KEY_SECRET_ID} does not look like a PEM private key`);
    }
    return pem.endsWith('\n') ? pem : `${pem}\n`;
}

function loadPem(cfg = readConfig()) {
    if (cfg.PRIVATE_KEY_SECRET_ID) {
        try {
            return fetchPemFromSecretsManager(cfg);
        } catch (e) {
            if (fs.existsSync(PEM_PATH)) {
                process.stderr.write(`bot-token: warn: ${e.message} — falling back to local ${PEM_PATH}\n`);
                return fs.readFileSync(PEM_PATH, 'utf8');
            }
            die(e.message);
        }
    }
    if (!fs.existsSync(PEM_PATH)) {
        die(`private key not found at ${PEM_PATH} (set PRIVATE_KEY_SECRET_ID in config to fetch it from AWS Secrets Manager)`);
    }
    return fs.readFileSync(PEM_PATH, 'utf8');
}

async function getToken() {
    // reuse cache if >5 min remaining
    if (fs.existsSync(TOKEN_CACHE)) {
        try {
            const c = JSON.parse(fs.readFileSync(TOKEN_CACHE, 'utf8'));
            if (c.token && c.expires_at && (new Date(c.expires_at).getTime() - Date.now()) > 5 * 60 * 1000) {
                return c.token;
            }
        } catch { /* fall through to refresh */ }
    }
    const cfg = readConfig();
    if (!cfg.APP_ID) die('APP_ID not set (config or SMALRUBY_BOT_APP_ID)');
    if (!cfg.INSTALLATION_ID) die('INSTALLATION_ID not set (config or SMALRUBY_BOT_INSTALLATION_ID)');
    const jwt = makeJwt(cfg.APP_ID, loadPem(cfg));
    const out = await api(`/app/installations/${cfg.INSTALLATION_ID}/access_tokens`, { method: 'POST', auth: jwt });
    fs.mkdirSync(CACHE_DIR, { recursive: true });
    fs.writeFileSync(TOKEN_CACHE, JSON.stringify({ token: out.token, expires_at: out.expires_at }), { mode: 0o600 });
    return out.token;
}

async function botEmail() {
    const cfg = readConfig();
    if (!cfg.APP_SLUG) die('APP_SLUG not set (config or SMALRUBY_BOT_APP_SLUG)');
    const token = await getToken();
    const user = await api(`/users/${encodeURIComponent(`${cfg.APP_SLUG}[bot]`)}`, { auth: token });
    return { name: `${cfg.APP_SLUG}[bot]`, email: `${user.id}+${cfg.APP_SLUG}[bot]@users.noreply.github.com` };
}

async function main() {
    const arg = process.argv[2];

    if (arg === '--print-jwt') {
        const cfg = readConfig();
        if (!cfg.APP_ID) die('APP_ID not set');
        process.stdout.write(makeJwt(cfg.APP_ID, loadPem()) + '\n');
        return;
    }

    if (arg === '--installations') {
        const cfg = readConfig();
        if (!cfg.APP_ID) die('APP_ID not set');
        const jwt = makeJwt(cfg.APP_ID, loadPem(cfg));
        const list = await api('/app/installations', { auth: jwt });
        for (const i of list) {
            process.stdout.write(`installation_id=${i.id}\taccount=${i.account && i.account.login}\ttarget=${i.target_type}\n`);
        }
        return;
    }

    if (arg === '--bot-email') {
        const { name, email } = await botEmail();
        process.stdout.write(`${name}\t${email}\n`);
        return;
    }

    if (arg === '--whoami') {
        const token = await getToken();
        const app = await api('/app', { auth: makeJwt(readConfig().APP_ID, loadPem()) });
        process.stderr.write(`app=${app.name} (slug=${app.slug}, id=${app.id})\n`);
        process.stdout.write(token.slice(0, 8) + '… (installation token ok)\n');
        return;
    }

    // default: print a valid installation token
    process.stdout.write(await getToken());
}

main().catch((e) => die(e && e.message ? e.message : String(e)));
