# Smalruby Classroom Environment Variables
#
# Environment files are managed per-stage and gitignored.
# Copy the appropriate template and create a symlink:
#
#   cp .env.example .env.prod    # then fill in real values
#   cp .env.example .env.stg     # then fill in real values
#   ln -s .env.stg .env          # switch active environment
#
# To switch environment:
#   rm .env && ln -s .env.stg .env

# AWS CDK Stage (stg / stg2 / prod)
STAGE=stg

# AWS Configuration (optional: CDK_DEFAULT_ACCOUNT/CDK_DEFAULT_REGION from AWS CLI take priority)
# AWS_ACCOUNT_ID=your-account-id
# AWS_REGION=ap-northeast-1

# Google OAuth Client ID (for id_token verification)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Microsoft Entra ID Client ID (for id_token verification, optional)
MICROSOFT_CLIENT_ID=

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://smalruby.app,https://smalruby.jp,http://localhost:8601

# Data retention in days (default 90 — covers a school term for term-end
# evaluation; stg typically uses 1 for fast cleanup)
# CLASSROOM_TTL_DAYS=90

# Classroom API endpoint (for integration tests)
# CLASSROOM_API_ENDPOINT=https://xxxx.execute-api.ap-northeast-1.amazonaws.com

# 期限切れ復元用の長期保持日数（S3 提出物 + DynamoDB 削除スナップショット。CLASSROOM_TTL_DAYS 以上が必須）
ARCHIVE_RETENTION_DAYS=365

# みんなの課題 (共有課題ライブラリ) のレート制限 (省略時 10 / 20)
SHARE_DAILY_LIMIT=10
REPORT_DAILY_LIMIT=20
