# Smalruby Bug Report Environment Variables
#
# Environment files are managed per-stage and gitignored.
# Copy the appropriate template and create a symlink:
#
#   cp .env.example .env.stg     # then fill in real values
#   cp .env.example .env.prod    # then fill in real values
#   ln -s .env.stg .env          # switch active environment
#
# To switch environment:
#   rm .env && ln -s .env.stg .env

# AWS CDK Stage (stg / stg2 / prod)
STAGE=stg

# AWS Configuration (optional: CDK_DEFAULT_ACCOUNT/CDK_DEFAULT_REGION from AWS CLI take priority)
# AWS_ACCOUNT_ID=your-account-id
# AWS_REGION=ap-northeast-1

# Google OAuth Client ID (for id_token verification — same as classroom)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Microsoft Entra ID Client ID (for id_token verification, optional)
MICROSOFT_CLIENT_ID=

# Bootstrap administrators (comma-separated emails). These are always treated as
# admins regardless of the Admins table. Set the very first admin here.
BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://smalruby.app,https://smalruby.jp,http://localhost:8601

# Resolved reports auto-expire after this many days (open reports are kept).
RESOLVED_TTL_DAYS=30

# Presigned URL expiry (seconds)
PRESIGNED_URL_UPLOAD_EXPIRY=900
PRESIGNED_URL_DOWNLOAD_EXPIRY=600

# Bug Report API endpoint (for integration tests)
# BUG_REPORT_API_ENDPOINT=https://xxxx.execute-api.ap-northeast-1.amazonaws.com

# Dev bypass token (stg only — skips Google/Microsoft auth for automated testing)
# DEV_BYPASS_TOKEN=
