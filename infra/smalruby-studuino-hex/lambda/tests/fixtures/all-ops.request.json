{
  "ir": {
    "version": 1,
    "board": "studuino",
    "ports": {
      "M1": "dc_motor", "M2": "dc_motor", "D9": "servo_motor", "D10": "servo_motor",
      "A0": "led", "A1": "buzzer", "A2": "touch_sensor", "A3": "push_switch",
      "A4": "sound_sensor", "A5": "ir_photoreflector", "A6": "light_sensor", "A7": "temperature_sensor"
    },
    "calibration": { "dcMotor": { "M1": 100, "M2": 90 }, "servoMotor": { "D9": -5, "D10": 3 } },
    "variables": [{ "id": "v0", "init": 0 }, { "id": "v1", "init": 1.5 }],
    "main": [
      { "op": "timer_reset" },
      { "op": "set", "var": "v0", "value": { "op": "random", "a": { "num": 1 }, "b": { "num": 10 } } },
      { "op": "change", "var": "v1", "by": { "op": "%", "a": { "var": "v0" }, "b": { "num": -3 } } },
      { "op": "repeat", "times": { "op": "round", "a": { "op": "/", "a": { "num": 7 }, "b": { "num": 2 } } },
        "body": [{ "op": "led", "port": "A0", "on": true }, { "op": "wait", "secs": { "num": 0.2 } }, { "op": "led", "port": "A0", "on": false }] },
      { "op": "wait_until", "cond": { "op": "button", "kind": "push_switch", "port": "A3" } },
      { "op": "forever", "body": [
        { "op": "if",
          "cond": { "op": "<", "a": { "op": "sensor", "kind": "light_sensor", "port": "A6" }, "b": { "num": 300 } },
          "then": [
            { "op": "dc_motor_speed", "port": "M1", "speed": { "op": "*", "a": { "num": 2 }, "b": { "op": "-", "a": { "num": 100 }, "b": { "op": "+", "a": { "num": 1 }, "b": { "num": 2 } } } } },
            { "op": "dc_motor_dir", "port": "M1", "dir": "normal" },
            { "op": "dc_motor_dir", "port": "M2", "dir": "reverse" }
          ],
          "else": [
            { "op": "dc_motor_stop", "port": "M1", "mode": "brake" },
            { "op": "dc_motor_stop", "port": "M2", "mode": "coast" }
          ] },
        { "op": "repeat_until",
          "cond": { "op": "or", "a": { "op": "not", "a": { "op": "button", "kind": "touch_sensor", "port": "A2" } }, "b": { "op": ">", "a": { "op": "timer" }, "b": { "num": 5 } } },
          "body": [
            { "op": "servo", "port": "D9", "angle": { "op": "sensor", "kind": "sound_sensor", "port": "A4" } },
            { "op": "servo_multi", "items": [{ "port": "D9", "angle": { "num": 0 } }, { "port": "D10", "angle": { "num": 180 } }] },
            { "op": "servo_multi", "items": [{ "port": "D9", "angle": { "num": 90 } }, { "port": "D10", "angle": { "num": 90 } }], "msPerDegree": 3 }
          ] },
        { "op": "if",
          "cond": { "op": "and",
            "a": { "op": "=", "a": { "op": "sensor", "kind": "ir_photoreflector", "port": "A5" }, "b": { "op": "to_num", "a": { "bool": true } } },
            "b": { "op": ">", "a": { "op": "sensor", "kind": "temperature_sensor", "port": "A7" }, "b": { "num": 0 } } },
          "then": [{ "op": "buzzer_on", "port": "A1", "pitch": { "num": 440 } }, { "op": "wait", "secs": { "var": "v1" } }, { "op": "buzzer_off", "port": "A1" }] }
      ] }
    ]
  }
}
