# Studuino hex API (smalruby-studuino-hex) の環境変数
#
# ステージごとのファイル（gitignored）を作り、.env を symlink にする:
#   cp .env.example .env.stg && ln -s .env.stg .env
# どれも省略できる（省略すると下の既定値）。秘密の値は無い。

STAGE=stg

# AWS（省略時は AWS CLI の設定から）
# AWS_ACCOUNT_ID=
# AWS_REGION=ap-northeast-1

# CORS（カンマ区切り）。省略すると https://smalruby.app（非 prod はローカル 8601〜8610 と
# ブランチプレビューも）。prod にローカルのオリジンを入れると synth が失敗する。
# CORS_ALLOWED_ORIGINS=https://smalruby.app

# 上限（S12）。省略すると下の値
# STUDUINO_MAX_REQUEST_BYTES=131072
# STUDUINO_COMPILE_TIMEOUT_MS=25000
# STUDUINO_RATE_LIMIT_PER_MINUTE=12
# STUDUINO_RATE_LIMIT_PER_DAY=600
# 構文木（Studuino IR）の上限（ノードの数・入れ子の深さ・変数の数）
# STUDUINO_MAX_IR_NODES=10000
# STUDUINO_MAX_IR_DEPTH=100
# STUDUINO_MAX_IR_VARIABLES=64

# 既存のカスタムドメインの下（/studuino）につなぐ。省略すると prod は api.smalruby.app、
# ほかは <STAGE>.api.smalruby.app（ドメインは smalruby-api が作る）。false でつながない
# STUDUINO_API_CUSTOM_DOMAIN=stg.api.smalruby.app
# ROUTE53_PARENT_ZONE_NAME=api.smalruby.app
