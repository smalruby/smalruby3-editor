# Rubytee Relay Environment Variables (Anthropic Claude)
#
# Environment files are managed per-stage and gitignored.
# Copy the appropriate template and create a symlink:
#
#   cp .env.example .env.prod    # then fill in real values
#   cp .env.example .env.stg     # then fill in real values
#   ln -s .env.stg .env          # switch active environment
#
# To switch environment:
#   rm .env && ln -s .env.stg .env

# AWS CDK Stage (stg / prod)
STAGE=stg

# AWS Configuration (optional: CDK_DEFAULT_ACCOUNT/CDK_DEFAULT_REGION from AWS CLI take priority)
# AWS_ACCOUNT_ID=your-account-id
# AWS_REGION=ap-northeast-1

# Anthropic Claude API (takeover worker only; the handler does not call Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Claude API via Workload Identity Federation (optional; takeover worker only).
# When rule / organization / service account are all set, the worker exchanges the
# Lambda role's AWS STS JWT for a short-lived token instead of using ANTHROPIC_API_KEY.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=35
RATE_LIMIT_MAX_REQUESTS=40

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://smalruby.app,https://smalruby.jp,http://localhost:8601

# Input validation
MIN_USER_MESSAGE_LENGTH=10

# Relay endpoint (for integration tests)
# RUBYTEE_RELAY_ENDPOINT=https://xxxx.execute-api.ap-northeast-1.amazonaws.com
