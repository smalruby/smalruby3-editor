# AWS Configuration
STAGE=stg
AWS_ACCOUNT_ID=your-account-id
# Use us-east-1 (global region) for best Gemini API availability and latency
# Gemini API global endpoint is most reliable from US regions
AWS_REGION=us-east-1

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=35
RATE_LIMIT_MAX_REQUESTS=40

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://smalruby.app,https://smalruby.jp,http://localhost:8601

# Input validation
MAX_USER_MESSAGE_LENGTH=250
