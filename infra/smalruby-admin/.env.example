# Deployment stage (stg / prod)
STAGE=stg

# Admin 専用 Google OAuth Client ID（決定 B。エディタ用 GOOGLE_CLIENT_ID とは別に GCP コンソールで作成する）
# prod では必須（未設定だとスタックが throw してデプロイ失敗）
ADMIN_GOOGLE_CLIENT_ID=your-admin-client-id.apps.googleusercontent.com

# 自動テスト用の認証バイパス（stg のみ。prod に設定するとデプロイが落ちる）
DEV_BYPASS_TOKEN=

# CORS 許可オリジン（省略時: prod=https://smalruby.app / それ以外=+http://localhost:8602）
CORS_ALLOWED_ORIGINS=

# カスタムドメイン（省略時: admin.api.smalruby.app / {stage}.admin.api.smalruby.app。false で無効化）
ADMIN_CUSTOM_DOMAIN=
ROUTE53_PARENT_ZONE_NAME=api.smalruby.app
