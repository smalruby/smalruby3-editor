!src/extensions/scratch3_tm2scratch/
!src/extensions/smalruby_ruby/

# Level 2: src/serialization/*
src/serialization/*
!src/serialization/smalruby-migration.js

# Level 2: src/util/*
src/util/*
!src/util/debug-logger.js

# ============================================================
# Level 1: test/*
# ============================================================
test/*
!test/integration/
!test/load-test/
!test/unit/

