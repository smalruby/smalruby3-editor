# Prettier whitelist for Smalruby-specific files only.
# Upstream (Scratch) files are excluded by default.
#
# How it works: ignore everything, then re-include Smalruby directories/files
# level by level (gitignore requires parent dirs to be un-ignored first).
#
# This file is the canonical whitelist of Smalruby-specific files for Prettier.
# (The .claude/rules mirror was removed; this file is the single source of truth.)
# When adding a new Smalruby-specific file, add it here.

# ============================================================
# Level 0: Ignore everything at root
# ============================================================
*
!src/
!test/

# ============================================================
# Level 1: src/*
# ============================================================
src/*
!src/extension-support/
!src/extensions/
!src/serialization/
!src/util/

# Level 2: src/extension-support/*
src/extension-support/*
!src/extension-support/smalruby-extensions.js

# Level 2: src/extensions/*
src/extensions/*
# Smalruby-only directories
!src/extensions/koshien/
!src/extensions/microbitMore/
!src/extensions/scratch3_mesh_v2/
!src/extensions/scratch3_mesh/
!src/extensions/scratch3_smalrubot_s1/
