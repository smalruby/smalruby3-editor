{
    "name": "@smalruby/admin",
    "version": "0.1.0",
    "private": true,
    "description": "Smalruby operator admin SPA (served at smalruby.app/admin/)",
    "license": "AGPL-3.0",
    "scripts": {
        "start": "webpack serve --mode development",
        "build": "webpack --mode production",
        "clean": "rimraf build",
        "test": "npm run test:lint && npm run test:unit",
        "test:lint": "eslint",
        "test:unit": "jest"
    },
    "dependencies": {
        "prop-types": "15.8.1",
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "devDependencies": {
        "@babel/core": "7.29.0",
        "@babel/preset-env": "7.29.2",
        "@babel/preset-react": "7.28.5",
        "@testing-library/jest-dom": "5.17.0",
        "@testing-library/react": "14.3.1",
        "babel-loader": "9.2.1",
        "css-loader": "5.2.7",
        "eslint": "9.39.4",
        "eslint-config-scratch": "14.1.12",
        "html-webpack-plugin": "5.6.7",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "rimraf": "2.7.1",
        "style-loader": "4.0.0",
        "webpack": "5.106.2",
        "webpack-cli": "5.1.4",
        "webpack-dev-server": "5.2.3"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "testMatch": [
            "<rootDir>/test/unit/**/*.test.{js,jsx}"
        ],
        "moduleNameMapper": {
            "\\.(css)$": "<rootDir>/test/style-mock.js"
        }
    }
}